{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keybound.dev/schema/wallet-policy.schema.json",
  "title": "Keybound executable wallet policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "defaultAction",
    "chains",
    "wallets",
    "validUntil",
    "protocolState",
    "simulation",
    "invariants",
    "contracts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "defaultAction": {
      "const": "deny"
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "wallets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/address"
      }
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "protocolState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "maxAgeSeconds",
        "threshold",
        "trustedKeys"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxClockSkewSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "minimumSequence": {
          "type": "integer",
          "minimum": 0
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "trustedKeys": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "algorithm",
              "publicKey"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "algorithm": {
                "const": "ed25519"
              },
              "publicKey": {
                "type": "string",
                "contentEncoding": "base64"
              }
            }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "blockTag",
        "quorum",
        "maxBlockSkew",
        "maxGasEstimate",
        "maxCallDepth",
        "maxInternalCalls",
        "maxStateAccounts",
        "maxStorageWrites",
        "denyCodeChanges",
        "eip7702",
        "allowedCallTypes",
        "internalTargets",
        "assetLimits",
        "sources"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "blockTag": {
          "enum": [
            "latest",
            "pending"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        },
        "quorum": {
          "type": "integer",
          "minimum": 2
        },
        "maxBlockSkew": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxGasEstimate": {
          "$ref": "#/$defs/uint"
        },
        "maxCallDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxInternalCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "maxStateAccounts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "maxStorageWrites": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "denyCodeChanges": {
          "const": true
        },
        "eip7702": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowAuthorizationList",
            "allowDelegatedWallet",
            "maxAuthorizations",
            "delegates"
          ],
          "properties": {
            "allowAuthorizationList": {
              "type": "boolean"
            },
            "allowDelegatedWallet": {
              "type": "boolean"
            },
            "maxAuthorizations": {
              "const": 1
            },
            "delegates": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chainId",
                  "address",
                  "codeHash"
                ],
                "properties": {
                  "chainId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "address": {
                    "$ref": "#/$defs/address"
                  },
                  "codeHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  }
                }
              }
            }
          }
        },
        "allowedCallTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "CALL",
              "STATICCALL",
              "DELEGATECALL",
              "CALLCODE"
            ]
          }
        },
        "internalTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chainId",
              "address"
            ],
            "properties": {
              "chainId": {
                "type": "integer",
                "minimum": 1
              },
              "address": {
                "$ref": "#/$defs/address"
              }
            }
          }
        },
        "assetLimits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chainId",
              "token",
              "maxOutflow",
              "maxApproval",
              "allowedRecipients",
              "allowedSpenders"
            ],
            "properties": {
              "chainId": {
                "type": "integer",
                "minimum": 1
              },
              "token": {
                "$ref": "#/$defs/address"
              },
              "maxOutflow": {
                "$ref": "#/$defs/uint"
              },
              "maxApproval": {
                "$ref": "#/$defs/uint"
              },
              "allowedRecipients": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/address"
                }
              },
              "allowedSpenders": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/address"
                }
              },
              "maxOutflowPerBlock": {
                "$ref": "#/$defs/uint",
                "description": "Most of this token the wallet may send in one block, across all transactions."
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "env"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxNativeValueWei",
        "maxGas"
      ],
      "properties": {
        "maxNativeValueWei": {
          "$ref": "#/$defs/uint"
        },
        "maxGas": {
          "$ref": "#/$defs/uint"
        },
        "maxGasPriceWei": {
          "$ref": "#/$defs/uint"
        },
        "maxFeePerGasWei": {
          "$ref": "#/$defs/uint"
        },
        "maxPriorityFeePerGasWei": {
          "$ref": "#/$defs/uint"
        },
        "requireCalldata": {
          "type": "boolean"
        },
        "denyUnlimitedApproval": {
          "const": true
        },
        "maxNativeOutflowPerBlockWei": {
          "$ref": "#/$defs/uint",
          "description": "Most native ETH the wallet may send in one block, across all transactions."
        },
        "maxSlippageBps": {
          "$ref": "#/$defs/uint",
          "description": "Most slippage a swap may accept, in basis points, measured from a fresh quote. Required when any method has swapQuote."
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chainId",
          "address"
        ],
        "properties": {
          "chainId": {
            "type": "integer",
            "minimum": 1
          },
          "address": {
            "$ref": "#/$defs/address"
          },
          "protocolId": {
            "type": "string",
            "minLength": 1
          },
          "maxNativeValueWei": {
            "$ref": "#/$defs/uint"
          },
          "maxGas": {
            "$ref": "#/$defs/uint"
          },
          "allowEmptyCalldata": {
            "type": "boolean"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selector"
              ],
              "properties": {
                "selector": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{8}$"
                },
                "name": {
                  "type": "string"
                },
                "maxGas": {
                  "$ref": "#/$defs/uint"
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "argument"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "address-in",
                          "uint-max",
                          "uint-min",
                          "uint-equals",
                          "bytes32-equals"
                        ]
                      },
                      "argument": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 63
                      },
                      "addresses": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/address"
                        }
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                },
                "swapQuote": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "quoter",
                    "wrappedNative",
                    "arguments",
                    "pools"
                  ],
                  "description": "Check this swap against a fresh on-chain quote from its measured pools.",
                  "properties": {
                    "kind": {
                      "const": "uniswap-v3-exact-input-single"
                    },
                    "quoter": {
                      "$ref": "#/$defs/address"
                    },
                    "wrappedNative": {
                      "$ref": "#/$defs/address"
                    },
                    "arguments": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tokenIn",
                        "tokenOut",
                        "fee",
                        "amountIn",
                        "minimumOut"
                      ],
                      "properties": {
                        "tokenIn": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "tokenOut": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "fee": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "amountIn": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "minimumOut": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        }
                      }
                    },
                    "pools": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "tokenA",
                          "tokenB",
                          "fee"
                        ],
                        "properties": {
                          "tokenA": {
                            "$ref": "#/$defs/address"
                          },
                          "tokenB": {
                            "$ref": "#/$defs/address"
                          },
                          "fee": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "blockedAddresses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/address"
      },
      "description": "Extra addresses to deny, on top of the shipped attacker list. The shipped list cannot be switched off."
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "uint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  }
}
