{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://callscout.dev/schema/protocol-monitor.schema.json",
  "title": "CallScout deterministic protocol monitor",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chainId", "stateTtlSeconds", "rpcQuorum", "maxBlockSkew", "sources", "protocols"],
  "properties": {
    "version": { "const": 1 },
    "chainId": { "type": "integer", "minimum": 1 },
    "stateTtlSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
    "rpcTimeoutMs": { "type": "integer", "minimum": 500, "maximum": 30000 },
    "rpcQuorum": { "type": "integer", "minimum": 2 },
    "maxBlockSkew": { "type": "integer", "minimum": 0, "maximum": 100 },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "env"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contracts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["address", "codeHash"],
              "properties": {
                "address": { "$ref": "#/$defs/address" },
                "codeHash": { "$ref": "#/$defs/bytes32" },
                "storage": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["slot", "equals"],
                    "properties": { "slot": { "$ref": "#/$defs/bytes32" }, "equals": { "$ref": "#/$defs/bytes32" } }
                  }
                },
                "calls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["data", "operator", "expected"],
                    "properties": {
                      "to": { "$ref": "#/$defs/address" },
                      "data": { "type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})+$" },
                      "operator": { "enum": ["equals", "not-equals", "uint-lte", "uint-gte"] },
                      "expected": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
