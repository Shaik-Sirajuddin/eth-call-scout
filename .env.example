# Optional monitoring-only credential for verified ABI lookup.
# Never put wallet private keys, seed phrases, or signing credentials in this file.
# Copy to .env and set the key locally. .env is ignored by git.
ETHERSCAN_API_KEY=

# Optional server-side AI translator for Policy Studio. The model only proposes
# an untrusted draft; deterministic validation still gates every policy.
OPENAI_API_KEY=
OPENAI_POLICY_MODEL=gpt-6-astra

# Independent read-only RPC endpoints used by protocol-monitor configuration.
CALLSCOUT_RPC_PRIMARY=
CALLSCOUT_RPC_SECONDARY=

# Independent trace-capable nodes for exact transaction simulation.
CALLSCOUT_SIM_PRIMARY=
CALLSCOUT_SIM_SECONDARY=

# Hosted Sepolia beta. Vercel holds only service credentials for the isolated
# Gateway; it must never hold the wallet private key. The Gateway URL must be
# HTTPS in hosted deployments. Use independent, random 32+ character secrets.
WALLETCORDON_GATEWAY_URL=
WALLETCORDON_GATEWAY_TOKEN=
WALLETCORDON_AGENT_API_KEYS=

# Optional local proxy testing. Hosted Vercel deployments always require auth.
WALLETCORDON_REQUIRE_AGENT_AUTH=0

# Isolated persistent Sepolia Gateway only. Do not configure these in Vercel.
# Use `npm run sepolia:prepare` to create a git-ignored local secret file.
WALLETCORDON_WALLET_PRIVATE_KEY=
WALLETCORDON_STATE_SIGNER_OPERATIONS=
WALLETCORDON_STATE_SIGNER_SECURITY=
WALLETCORDON_SEPOLIA_RPC_PRIMARY=
WALLETCORDON_SEPOLIA_RPC_SECONDARY=
WALLETCORDON_GATEWAY_CONFIG=deployments/sepolia.json
WALLETCORDON_GATEWAY_DATA_DIR=.walletcordon/sepolia

# Optional: where `keybound attackers update` downloads the latest list. Defaults to the public file on GitHub.
KEYBOUND_ATTACKER_LIST_URL=
