# Optional monitoring-only credential for verified ABI lookup.
# Never put wallet private keys, seed phrases, or signing credentials in this file.
# Copy to .env and set the key locally. .env is ignored by git.
ETHERSCAN_API_KEY=

# Independent read-only RPC endpoints used by protocol-monitor configuration.
CALLSCOUT_RPC_PRIMARY=
CALLSCOUT_RPC_SECONDARY=

# Independent trace-capable nodes for exact transaction simulation.
CALLSCOUT_SIM_PRIMARY=
CALLSCOUT_SIM_SECONDARY=
